# Database (Railway provides these automatically for PostgreSQL plugin)
DATABASE_URL=jdbc:postgresql://localhost:5433/expense_tracker
DATABASE_USERNAME=expense_user
DATABASE_PASSWORD=expense_pass

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-characters

# Server
PORT=8081

# File uploads
UPLOADS_DIR=./uploads

# Frontend (set in frontend service)
BACKEND_URL=http://localhost:8081
